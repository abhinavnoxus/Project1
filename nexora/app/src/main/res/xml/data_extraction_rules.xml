<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="nexora.db" />
        <include domain="sharedpref" path="nexora_interface.preferences_pb" />
        <exclude domain="sharedpref" path="nexora_alarm_occurrences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="nexora.db" />
        <include domain="sharedpref" path="nexora_interface.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
